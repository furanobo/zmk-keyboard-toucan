#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE     0
#define NAV      1
#define SYM      2
#define ADJ      3
#define MOUSE    4
#define SLOW     7
#define SLOW_SCR 8
#define FAST     9
#define FAST_SCR 10

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };

        slow_scroll_nav {
            if-layers = <SLOW NAV>;
            then-layer = <SLOW_SCR>;
        };

        slow_scroll_sym {
            if-layers = <SLOW SYM>;
            then-layer = <SLOW_SCR>;
        };

        fast_scroll_nav {
            if-layers = <FAST NAV>;
            then-layer = <FAST_SCR>;
        };

        fast_scroll_sym {
            if-layers = <FAST SYM>;
            then-layer = <FAST_SCR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ┌───────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬──────┐
        // │  TAB  │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │ BSPC │
        // │ GRAVE │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  ;  │  '   │
        // │ LSHFT │  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │ ESC  │
        // └───────┴─────┴──┬──┴──┬──┴──┬──┴─────┘   └─────┴──┬──┴──┬──┴──┬──┴─────┴──────┘
        //                  │LCTRL│ NAV │SPACE│           │ RET │ SYM │RALT │
        //                  └─────┴─────┴─────┘           └─────┴─────┴─────┘
        base {
            display-name = "BASE";
            bindings = <
                &kp TAB    &kp Q  &kp W       &kp E  &kp R  &kp T       &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
                &kp GRAVE  &kp A  &kp S       &kp D  &kp F  &kp G       &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &mt LGUI X  &kp C  &kp V  &kp B       &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                       &kp LCTRL  &mo NAV  &kp SPACE    &kp RET  &mo SYM  &kp RALT
            >;
        };

        // ┌───────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬───────┬──────┬──────┐
        // │  TAB  │  1   │  2   │  3   │  4   │  5   │   │  6   │  7   │  8   │   9   │  0   │ BSPC │
        // │BT CLR │ BT 0 │ BT 1 │ BT 2 │ BT 3 │ BT 4 │   │  ←   │  ↓   │  ↑   │   →   │ HOME │ END  │
        // │ LSHFT │UNLOCK│      │      │      │      │   │PG DN │PG UP │      │       │ INS  │      │
        // └───────┴──────┴──┬───┴──┬───┴──┬───┴──────┘   └──────┴──┬───┴──┬───┴──┬────┴──────┴──────┘
        //                   │      │ held │SPACE │           │ RET  │      │ RALT │
        //                   └──────┴──────┴──────┘           └──────┴──────┴──────┘
        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6     &kp N7     &kp N8  &kp N9     &kp N0    &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &kp LEFT   &kp DOWN   &kp UP  &kp RIGHT  &kp HOME  &kp END
                &kp LSHFT   &studio_unlock  &trans       &trans        &trans        &trans            &kp PG_DN  &kp PG_UP  &trans  &trans     &kp INS   &trans
                                                          &trans        &trans        &kp SPACE         &kp RET    &trans     &kp RALT
            >;
        };

        // ┌───────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │  ESC  │  !   │  @   │  #   │  $   │  %   │   │  7   │  8   │  9   │  -   │  =   │ DEL  │
        // │ LCTRL │  [   │  ]   │  (   │  )   │  ^   │   │  4   │  5   │  6   │  +   │  *   │  |   │
        // │ LSHFT │  \   │  _   │  {   │  }   │  &   │   │  1   │  2   │  3   │  0   │  .   │  ~   │
        // └───────┴──────┴──┬───┴──┬───┴──┬───┴──────┘   └──────┴──┬───┴──┬───┴──┬───┴──────┴──────┘
        //                   │      │      │SPACE │           │ RET  │ held │      │
        //                   └──────┴──────┴──────┘           └──────┴──────┴──────┘
        sym {
            display-name = "SYM";
            bindings = <
                &kp ESC    &kp EXCL  &kp AT     &kp HASH  &kp DLLR  &kp PRCNT     &kp N7   &kp N8  &kp N9  &kp MINUS  &kp EQUAL  &kp DEL
                &kp LCTRL  &kp LBKT  &kp RBKT   &kp LPAR  &kp RPAR  &kp CARET     &kp N4   &kp N5  &kp N6  &kp PLUS   &kp ASTRK  &kp PIPE
                &kp LSHFT  &kp BSLH  &kp UNDER  &kp LBRC  &kp RBRC  &kp AMPS      &kp N1   &kp N2  &kp N3  &kp N0     &kp DOT    &kp TILDE
                                                  &trans    &trans    &kp SPACE     &kp RET  &trans   &trans
            >;
        };

        // ┌───────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │  F1   │  F2  │  F3  │  F4  │  F5  │  F6  │   │  F7  │  F8  │  F9  │ F10  │ F11  │ F12  │
        // │       │      │      │      │      │      │   │  ⏮  │  🔉  │  🔊  │  ⏭  │      │      │
        // │       │      │      │      │      │      │   │T SLOW│T FAST│  🔇  │      │      │      │
        // └───────┴──────┴──┬───┴──┬───┴──┬───┴──────┘   └──────┴──┬───┴──┬───┴──┬───┴──────┴──────┘
        //                   │      │      │      │           │      │      │      │
        //                   └──────┴──────┴──────┘           └──────┴──────┴──────┘
        adj {
            display-name = "ADJ";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6      &kp F7     &kp F8        &kp F9        &kp F10     &kp F11  &kp F12
                &trans  &trans  &trans  &trans  &trans  &trans      &kp C_PREV &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &trans   &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &tog SLOW  &tog FAST     &kp C_MUTE    &trans      &trans   &trans
                                         &trans  &trans  &trans      &trans     &trans        &trans
            >;
        };

        // ┌───────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │       │      │      │      │      │      │   │      │      │      │      │      │      │
        // │       │      │ RCLK │ MCLK │ LCLK │      │   │      │      │      │      │      │      │
        // │       │      │      │      │      │      │   │      │      │      │      │      │      │
        // └───────┴──────┴──┬───┴──┬───┴──┬───┴──────┘   └──────┴──┬───┴──┬───┴──┬───┴──────┴──────┘
        //                   │      │ LCLK │      │           │      │      │      │
        //                   └──────┴──────┴──────┘           └──────┴──────┴──────┘
        // Activated automatically by zip_temp_layer when trackpad is touched
        mouse {
            display-name = "MOUSE";
            bindings = <
                &trans  &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans     &mkp LCLK  &trans      &trans  &trans  &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };

        slow {
            display-name = "SLOW";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        slow_scr {
            display-name = "SLOW_SCR";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        fast {
            display-name = "FAST";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        fast_scr {
            display-name = "FAST_SCR";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };
    };
};
