#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE     0
#define NAV      1
#define SYM      2
#define ADJ      3
#define MOUSE    4
#define SLOW     7
#define SLOW_SCR 8
#define FAST     9
#define FAST_SCR 10

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };

        slow_scroll_nav {
            if-layers = <SLOW NAV>;
            then-layer = <SLOW_SCR>;
        };

        slow_scroll_sym {
            if-layers = <SLOW SYM>;
            then-layer = <SLOW_SCR>;
        };

        fast_scroll_nav {
            if-layers = <FAST NAV>;
            then-layer = <FAST_SCR>;
        };

        fast_scroll_sym {
            if-layers = <FAST SYM>;
            then-layer = <FAST_SCR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans     &trans     &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &kp LANG2    &kp LANG1   &trans       &trans     &trans     &trans
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &tog SLOW    &tog FAST   &trans       &trans     &trans     &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo SYM &kp RALT
            >;
        };

        // Activated automatically by zip_temp_layer when trackpad is touched (2s timeout)
        // Left home row: S=RCLK, D=MCLK, F=LCLK / Left thumb: LCLK
        mouse {
            display-name = "MOUSE";
            bindings = <
                &trans &trans &trans    &trans    &trans    &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &mkp RCLK &mkp MCLK &mkp LCLK &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans    &trans    &trans    &trans   &trans &trans &trans &trans &trans &trans
                                        &trans    &mkp LCLK &trans   &trans &trans &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };

        slow {
            display-name = "SLOW";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        slow_scr {
            display-name = "SLOW_SCR";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        fast {
            display-name = "FAST";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        fast_scr {
            display-name = "FAST_SCR";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
