#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/speed_step.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define NAV      1
#define SYM      2
#define ADJ      3
#define MOUSE    4

/ {
    behaviors {
        mss: mouse_speed_step {
            compatible = "zmk,behavior-speed-step";
            #binding-cells = <1>;
            processor = <&mouse_speed>;
        };

        sss: scroll_speed_step {
            compatible = "zmk,behavior-speed-step";
            #binding-cells = <1>;
            processor = <&scroll_speed>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        window_left: window_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT>;
            label = "WINDOW_LEFT";
        };

        window_right: window_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp RIGHT>;
            label = "WINDOW_RIGHT";
        };

        pass: pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp A &kp S &kp U &kp D &kp LS(A) &kp Y &kp O &kp N9 &kp N6 &kp EXCL>;
            label = "PASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp GRAVE  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp ENTER  &kp LSHFT  &kp Z  &mt LEFT_GUI X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp SPACE  &lt 1 LCTRL  &kp SPACE  &lt 3 SEMICOLON  &kp SEMICOLON  &kp SLASH
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp ESC  &trans  &window_left  &kp UP  &window_right  &trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp CARET  &kp DEL  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &kp N4  &kp N5  &kp N6  &kp PLUS  &kp MINUS  &kp RET  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &kp STAR  &kp FSLH  &trans  &trans  &trans  &trans  &kp SEMI  &kp COLON  &kp N0
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";

            // Right bottom row: Mouse speed DN/UP, Scroll speed DN/UP

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &mss SPEED_STEP_DN  &mss SPEED_STEP_UP  &sss SPEED_STEP_DN  &sss SPEED_STEP_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &mkp MB4  &mkp MB5  &trans
            >;
        };
    };
};
